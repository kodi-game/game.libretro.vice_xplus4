msgctxt "#30541"
msgid "Press the mapped key to toggle the statusbar."
msgstr "Stisknutím namapované klávesy přepnete stavový řádek."

msgctxt "#30542"
msgid ""
"Press the mapped key to switch joyports 1 & 2.\n"
"Switching disables 'RetroPad Port' option until core restart."
msgstr ""
"Stisknutím namapované klávesy přepnete joyporty 1 a 2.\n"
"Přepnutí deaktivuje volbu 'Port RetroPadu' do restartu jádra."

msgctxt "#30543"
msgid "Press the mapped key to toggle turbo fire."
msgstr "Stisknutím namapované klávesy přepnete automatickou střelbu."

msgctxt "#30544"
msgid "Press the mapped key to create/insert/eject a save disk."
msgstr "Stisknutím namapované klávesy vytvoříte/vložíte/vysunete ukládací disk."

msgctxt "#30545"
msgid ""
"Press the mapped key to toggle aspect ratio.\n"
"Toggling disables 'Pixel Aspect Ratio' option until core restart."
msgstr ""
"Stisknutím namapované klávesy přepnete poměr stran.\n"
"Přepnutí deaktivuje volbu 'Poměr stran pixelů' do restartu jádra."

msgctxt "#30546"
msgid "Press the mapped key to toggle crop."
msgstr "Stisknutím namapované klávesy přepnete oříznutí."

msgctxt "#30547"
msgid "Press the mapped key to toggle Datasette hotkeys."
msgstr "Stisknutím namapované klávesy přepnete zkratky jednotky Datasette."

msgctxt "#30548"
msgid "Press play on tape."
msgstr "Stiskněte přehrávání kazety."

msgctxt "#30549"
msgid "Press stop on tape."
msgstr "Stiskněte zastavení kazety."

msgctxt "#30550"
msgid "Press rewind on tape."
msgstr "Stiskněte převinutí kazety zpět."

msgctxt "#30551"
msgid "Press fast forward on tape."
msgstr "Stiskněte rychlé převinutí kazety vpřed."

msgctxt "#30552"
msgid "Reset tape to beginning."
msgstr "Resetuje kazetu na začátek."

msgctxt "#30553"
msgid "Press the mapped key to trigger the selected 'Reset Type'."
msgstr "Stisknutím namapované klávesy aktivujete vybraný 'Typ resetu'."

msgctxt "#30554"
msgid "Hold the mapped key for warp mode."
msgstr "Podržením namapované klávesy aktivujete zrychlený režim."

